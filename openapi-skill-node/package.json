{
  "name": "openapi-skill",
  "version": "2.2.2",
  "description": "Generate one project API documentation Skill from multiple OpenAPI 3.0.x/3.1.x services.",
  "type": "module",
  "bin": {
    "openapi-skill": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE",
    "DEVELOPMENT.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm test",
    "benchmark": "npm run build && node scripts/benchmark-retrieval.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "openapi",
    "codex",
    "skill",
    "microservices",
    "api-documentation",
    "typescript"
  ],
  "homepage": "https://github.com/fyuanz/openapi-skill#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fyuanz/openapi-skill.git"
  },
  "bugs": {
    "url": "https://github.com/fyuanz/openapi-skill/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "js-tiktoken": "1.0.21",
    "typescript": "^5.9.0"
  }
}
