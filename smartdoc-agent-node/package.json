{
  "name": "@fyuanz/smartdoc-agent",
  "version": "1.3.0",
  "description": "Generate a Codex Skill from one or more OpenAPI 3.1.0 JSON endpoints.",
  "type": "module",
  "bin": {
    "smartdoc-agent": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["openapi", "codex", "skill", "vue3", "typescript"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
