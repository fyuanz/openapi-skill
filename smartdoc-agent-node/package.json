{
  "name": "smartdoc-agent",
  "version": "1.5.0",
  "description": "Generate one project API documentation Skill from multiple OpenAPI 3.1.0 services.",
  "type": "module",
  "bin": {
    "smartdoc-agent": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "README.en.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["openapi", "codex", "skill", "microservices", "api-documentation", "typescript"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
